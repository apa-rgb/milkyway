{
  "name": "milkyway-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node bootstrap.mjs",
    "accounts": "node provision-accounts.mjs",
    "configure": "node configure-android.mjs",
    "test": "node --test accounts.test.mjs",
    "test:auth": "firebase emulators:exec --project demo-milkyway --only auth 'node --test auth-emulator.test.mjs'",
    "test:emulators": "firebase emulators:exec --project demo-milkyway --only auth,database 'node --test auth-emulator.test.mjs emulator.test.mjs'"
  },
  "dependencies": {
    "firebase-admin": "13.2.0",
    "google-auth-library": "9.15.1"
  },
  "devDependencies": {
    "firebase": "11.6.0",
    "firebase-tools": "14.2.1"
  }
}
